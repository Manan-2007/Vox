# Python
venv/
__pycache__/
*.py[cod]

# Node
node_modules/
frontend/dist/

# MediaPipe assets staged into the Vite app by frontend/scripts/copy-assets.mjs
# (~42 MB of wasm + a 7.8 MB model). Regenerated by npm run dev / build.
frontend/public/mediapipe/
frontend/public/models/

# ML artifacts. Raw data and the MediaPipe bundle are regenerated
# (ml/fetch_dictionary.py + ml/extract.py; collect.py downloads the bundle), but
# the small trained model SHIPS so the product works out of the box.
ml/data/
ml/models/hand_landmarker.task
ml/models/pose_landmarker_lite.task

# Source dictionary clips: ~90 MB of video, re-downloadable in about 25 minutes
# with `python ml/fetch_dictionary.py --download`. What ships instead is the
# landmark motion extracted from them (frontend/public/signs/), which is a
# twentieth of the size and, unlike the clips, carries nobody's likeness.
ml/videos/

# OS / editor
.DS_Store
.vscode/
.idea/
